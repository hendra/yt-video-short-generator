node_modules
dist
.DS_Store
.env

# Ignore the output video from Git but not videos you import into src/.
out

# Generated by scripts/music.ts (npm run music / predev / prerender)
public/*/music.wav

# tts.mts publish staging temps (crash leftovers)
public/*/.vo.mp3.*.tmp
src/videos/*/.alignment.json.*.tmp

# Steam trailer clips + their index + staging dir (npm run footage regenerates them)
public/*/clips/
public/*/clips.json
public/*/.clips.tmp/

# superpowers scratch (SDD workspace)
.superpowers/

# TTS voiceovers are deleted from the tree after every publish (durable upstream).
public/*/vo.mp3

# Generated video source stays out of git. CI fetches published-post metadata to /tmp only.
src/videos/*/
