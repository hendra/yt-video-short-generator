{
  "name": "explainer-3d",
  "version": "1.0.0",
  "description": "3D explainer Shorts/Reels with Remotion + React Three Fiber, ElevenLabs voiceover and karaoke captions",
  "scripts": {
    "predev": "tsx scripts/music.mts --missing",
    "dev": "remotion studio",
    "prerender": "tsx scripts/music.mts --missing",
    "tts": "tsx scripts/tts.mts",
    "align": "tsx scripts/align.mts",
    "align:local": "tsx scripts/align-local.mts",
    "timeline": "tsx scripts/build-timeline.mts",
    "check-sync": "tsx scripts/check-sync.mts",
    "check-motion": "tsx scripts/check-motion.mts",
    "music": "tsx scripts/music.mts",
    "footage": "tsx scripts/fetch-footage.mts",
    "credits": "tsx scripts/credits.mts",
    "render": "REMOTION_GPU=1 remotion render --gl=angle",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc && tsc -p scripts",
    "test": "tsx --test scripts/*.test.mts",
    "publish": "tsx scripts/publish.mts",
    "report": "tsx scripts/report.mts"
  },
  "repository": {},
  "license": "UNLICENSED",
  "dependencies": {
    "@react-three/fiber": "9.2.0",
    "@remotion/cli": "^4.0.0",
    "@remotion/media": "^4.0.0",
    "@remotion/three": "^4.0.0",
    "@remotion/zod-types": "^4.0.0",
    "mediabunny": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "^4.0.0",
    "three": "0.178.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "^4.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true
}
